{
  "name": "@maroonedsoftware/servercore",
  "version": "0.1.0",
  "description": "Framework-agnostic ServerKit core: module lifecycle, body parsers, SSE transport, error rendering, and guard helpers shared by the Koa and Fastify adapters",
  "author": {
    "name": "Marooned Software",
    "url": "https://github.com/MaroonedSoftware/serverkit"
  },
  "bugs": {
    "url": "https://github.com/MaroonedSoftware/serverkit/issues"
  },
  "homepage": "https://github.com/MaroonedSoftware/serverkit/packages/servercore#readme",
  "keywords": [
    "backend",
    "serverkit",
    "http",
    "sse",
    "streaming",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaroonedSoftware/serverkit.git"
  },
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "files": [
    "AGENTS.md",
    "dist/**"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --sourcemap && tsc --emitDeclarationOnly --declaration",
    "build:ci": "eslint --max-warnings=0 && pnpm run build",
    "lint": "eslint --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:ci": "vitest run --coverage"
  },
  "dependencies": {
    "@hapi/bourne": "^4.0.1",
    "@maroonedsoftware/appconfig": "workspace:*",
    "@maroonedsoftware/errors": "workspace:*",
    "@maroonedsoftware/logger": "workspace:*",
    "@maroonedsoftware/multipart": "workspace:*",
    "@maroonedsoftware/policies": "workspace:*",
    "@maroonedsoftware/utilities": "workspace:*",
    "inflation": "^2.1.0",
    "injectkit": "^1.7.1",
    "luxon": "^3.7.2",
    "qs": "^6.16.0",
    "rate-limiter-flexible": "^11.2.0",
    "raw-body": "^4.0.0",
    "type-is": "^2.1.0"
  },
  "devDependencies": {
    "@repo/config-eslint": "workspace:*",
    "@repo/config-typescript": "workspace:*",
    "@types/inflation": "^2.0.4",
    "@types/luxon": "^3.7.5",
    "@types/qs": "^6.15.1",
    "@types/type-is": "^1.6.7"
  },
  "engines": {
    "node": ">=22"
  }
}
