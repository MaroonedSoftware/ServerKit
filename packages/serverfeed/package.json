{
  "name": "@maroonedsoftware/serverfeed",
  "version": "0.1.0",
  "description": "Framework-agnostic, transport-free in-process feed of realtime server activity (pub/sub, replay buffer, snapshot) for ServerKit.",
  "author": {
    "name": "Marooned Software",
    "url": "https://github.com/MaroonedSoftware/serverkit"
  },
  "bugs": {
    "url": "https://github.com/MaroonedSoftware/serverkit/issues"
  },
  "homepage": "https://github.com/MaroonedSoftware/serverkit/packages/serverfeed#readme",
  "keywords": [
    "backend",
    "serverfeed",
    "realtime",
    "pubsub",
    "serverkit",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaroonedSoftware/serverkit.git"
  },
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "import": "./dist/logger.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "files": [
    "AGENTS.md",
    "dist/**"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/logger.ts --format esm --sourcemap && tsc --emitDeclarationOnly --declaration",
    "build:ci": "eslint --max-warnings=0 && pnpm run build",
    "lint": "eslint --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:ci": "vitest run --coverage"
  },
  "dependencies": {
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@maroonedsoftware/logger": "workspace:*",
    "@repo/config-eslint": "workspace:*",
    "@repo/config-typescript": "workspace:*",
    "@types/luxon": "^3.7.2"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@maroonedsoftware/logger": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@maroonedsoftware/logger": {
      "optional": true
    }
  }
}
