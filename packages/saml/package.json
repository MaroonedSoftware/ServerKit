{
  "name": "@maroonedsoftware/saml",
  "version": "0.3.1",
  "description": "SAML 2.0 service-provider toolkit for ServerKit: per-provider configuration from a pluggable source, IdP metadata parsing, SP metadata generation, and SP-initiated sign-in as an authentication factor on @node-saml/node-saml.",
  "author": {
    "name": "Marooned Software",
    "url": "https://github.com/MaroonedSoftware/serverkit"
  },
  "bugs": {
    "url": "https://github.com/MaroonedSoftware/serverkit/issues"
  },
  "homepage": "https://github.com/MaroonedSoftware/serverkit/packages/saml#readme",
  "keywords": [
    "backend",
    "saml",
    "saml2",
    "sso",
    "identity",
    "serverkit",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaroonedSoftware/serverkit.git"
  },
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "files": [
    "AGENTS.md",
    "dist/**"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --sourcemap && tsc --emitDeclarationOnly --declaration",
    "build:ci": "eslint --max-warnings=0 && pnpm run build",
    "lint": "eslint --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:ci": "vitest run --coverage"
  },
  "dependencies": {
    "@maroonedsoftware/authentication": "workspace:*",
    "@maroonedsoftware/cache": "workspace:*",
    "@maroonedsoftware/errors": "workspace:*",
    "@maroonedsoftware/policies": "workspace:*",
    "@node-saml/node-saml": "^5.1.0",
    "@xmldom/xmldom": "^0.8.15",
    "injectkit": "^1.7.1",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@repo/config-eslint": "workspace:*",
    "@repo/config-typescript": "workspace:*",
    "@types/luxon": "^3.7.5",
    "xml-crypto": "^6.4.0"
  },
  "engines": {
    "node": ">=22"
  }
}
