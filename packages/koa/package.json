{
  "name": "@maroonedsoftware/koa",
  "version": "3.2.3",
  "description": "Koa middleware, body parsing, SSE streaming, and utilities for ServerKit",
  "author": {
    "name": "Marooned Software",
    "url": "https://github.com/MaroonedSoftware/serverkit"
  },
  "bugs": {
    "url": "https://github.com/MaroonedSoftware/serverkit/issues"
  },
  "homepage": "https://github.com/MaroonedSoftware/serverkit/packages/koa#readme",
  "keywords": [
    "backend",
    "koa",
    "sse",
    "streaming",
    "serverkit",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaroonedSoftware/serverkit.git"
  },
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./serverfeed": {
      "types": "./dist/serverfeed.d.ts",
      "import": "./dist/serverfeed.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "files": [
    "AGENTS.md",
    "dist/**"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/serverfeed.ts --format esm --sourcemap && tsc --emitDeclarationOnly --declaration",
    "build:ci": "eslint --max-warnings=0 && pnpm run build",
    "lint": "eslint --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:ci": "vitest run --coverage"
  },
  "dependencies": {
    "@maroonedsoftware/appconfig": "workspace:*",
    "@maroonedsoftware/authentication": "workspace:*",
    "@maroonedsoftware/errors": "workspace:*",
    "@maroonedsoftware/logger": "workspace:*",
    "@maroonedsoftware/policies": "workspace:*",
    "@maroonedsoftware/servercore": "workspace:*",
    "injectkit": "^1.7.1",
    "luxon": "^3.7.2"
  },
  "peerDependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.2.0",
    "@maroonedsoftware/serverfeed": "workspace:*",
    "koa": "^3.1.1"
  },
  "peerDependenciesMeta": {
    "@maroonedsoftware/serverfeed": {
      "optional": true
    }
  },
  "devDependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.7.0",
    "@maroonedsoftware/serverfeed": "workspace:*",
    "@repo/config-eslint": "workspace:*",
    "@repo/config-typescript": "workspace:*",
    "@types/koa": "^3.0.3",
    "@types/koa__cors": "^5.0.1",
    "@types/luxon": "^3.7.5",
    "koa": "^3.2.1",
    "rate-limiter-flexible": "^11.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
