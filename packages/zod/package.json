{
  "name": "@maroonedsoftware/zod",
  "version": "0.7.2",
  "description": "Zod utilities for ServerKit.",
  "author": {
    "name": "Marooned Software",
    "url": "https://github.com/MaroonedSoftware/serverkit"
  },
  "bugs": {
    "url": "https://github.com/MaroonedSoftware/serverkit/issues"
  },
  "homepage": "https://github.com/MaroonedSoftware/serverkit/packages/zod#readme",
  "keywords": [
    "backend",
    "zod",
    "serverkit",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaroonedSoftware/serverkit.git"
  },
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./serializer": {
      "types": "./dist/serializer.d.ts",
      "import": "./dist/serializer.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "files": [
    "AGENTS.md",
    "dist/**"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/serializer.ts --format esm --sourcemap && tsc --emitDeclarationOnly --declaration",
    "build:ci": "eslint --max-warnings=0 && pnpm run build",
    "lint": "eslint --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:ci": "vitest run --coverage"
  },
  "dependencies": {
    "@maroonedsoftware/errors": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@repo/config-eslint": "workspace:*",
    "@repo/config-typescript": "workspace:*",
    "fast-json-stringify": "^7.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "fast-json-stringify": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "fast-json-stringify": {
      "optional": true
    }
  }
}
